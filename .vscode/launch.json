{
    // Depurar desde el monorepo. Para el engine usa el perfil de Python o
    // `python -m uvicorn main:app --reload` en mana-forge-engine.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "ManaForgeApiApplication",
            "request": "launch",
            "mainClass": "com.manaforge.api.ManaForgeApiApplication",
            "projectName": "mana-forge-api"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ]
}
